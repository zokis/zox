-# while-scoped let does not redeclare on second iteration
let i = 0;
#(i < 4) {
    let x = i * 2;
    println(x);
    i = i + 1
};

-# for-scoped let keeps existing behavior
@(let j = 0; j < 3; j = j + 1) {
    let y = j * 3;
    println(y)
};

-# closures capture per-iteration while scope
let funcs = {};
let k = 0;
#(k < 3) {
    let n = k;
    $ f() { n }
    funcs << f;
    k = k + 1
};
println(funcs[0]());
println(funcs[1]());
println(funcs[2]());
