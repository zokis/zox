-# Zox Memory Stress Benchmark - Full Language Coverage

~> string { toString };

$ method_for(i) {
    ?(i % 5 == 0) { "POST" } :? (i % 7 == 0) { "PUT" } : { "GET" }
}

$ status_for(i) {
    ?(i % 17 == 0) { 500 } :? (i % 13 == 0) { 404 } :? (i % 11 == 0) { 401 } : { 200 }
}

type LogEntry { method, path, status, ms, tag, metadata, trace };
type Metadata { bucket, region, priority, tags };
type Trace { id, parent_id, depth };

$ make_log(i) {
    -# Nesting structures to stress promotion and depth
    let trace = Trace(toString(i), toString(i-1), i % 10);
    let meta = Metadata(
        "bucket-" + toString(i % 64),
        ?(i % 2 == 0) { "us-east" } : { "eu-west" },
        i % 5,
        [ "env" -> "prod"; "tier" -> "api" ]
    );
    
    LogEntry(
        method_for(i),
        "/api/resource/" + toString(i % 1000),
        status_for(i),
        (i * 37) % 1000,
        "request-" + toString(i),
        meta,
        trace
    )
}

$ build_logs(n) {
    let logs = {};
    let i = 0;
    #(i < n) {
        -# Periodically use an arena to create short-lived pressure
        ?(i % 100 == 0) {
            let temp = |{
                let batch = {};
                @(let j = 0; j < 10; j = j + 1) { batch << make_log(i + j) }
                _>> batch
            }|;
            @(let k = 0; k < len(temp); k = k + 1) { logs << temp[k] };
            i = i + 10
        } : {
            logs << make_log(i);
            i = i + 1
        }
    }
    logs
}

$ process_logs(logs) {
    let total_ms = 0;
    let errors = 0;
    let paths = {};
    @(let i = 0; i < len(logs); i = i + 1) {
        let entry = logs[i];
        total_ms = total_ms + entry.ms;
        ?(entry.status >= 400) {
            errors = errors + 1;
            paths << entry.path
        }
    }
    {total_ms, errors, len(paths)}
}

-# Main Execution
let start_logs = build_logs(30000);
let stats = process_logs(start_logs);

println(len(start_logs))
println(stats[0])
println(stats[1])
println(stats[2])

-# Verify promotion and deep access
println(start_logs[0].metadata.tags{"env"})
println(start_logs[29999].trace.id)
