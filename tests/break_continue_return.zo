-# while break: stops at j == 5, sum should be 5
let soma = 0;
let j = 0;
#(j < 10) {
    ?(j == 5) {
        ~!!
    }
    soma = soma + 1
    j = j + 1
};
println(soma);

-# while continue: counts evens from 1..10, should be 5
let pares = 0;
let k = 0;
#(k < 10) {
    k = k + 1
    ?(k % 2 != 0) {
        __>
    }
    pares = pares + 1
};
println(pares);

-# for break: stops at n == 7, total should be 7
let total = 0;
@(let n = 0; n < 100; n = n + 1) {
    ?(n == 7) {
        ~!!
    }
    total = total + 1
};
println(total);

-# for continue: counts odds from 0..9, should be 5
let impares = 0;
@(let m = 0; m < 10; m = m + 1) {
    ?(m % 2 == 0) {
        __>
    }
    impares = impares + 1
};
println(impares);

-# simple return
$ dobro(x) {
    _>> x * 2
};
println(dobro(7));

-# early return
$ primeiro_negativo(lista) {
    let idx = 0;
    #(idx < len(lista)) {
        ?(lista[idx] < 0) {
            _>> lista[idx]
        }
        idx = idx + 1
    }
    _>> nil
};
println(primeiro_negativo({1, 2, -3, 4}));
println(primeiro_negativo({1, 2, 3}));

-# recursive return (factorial)
$ fatorial(n) {
    ?(n <= 1) {
        _>> 1
    }
    _>> n * fatorial(n - 1)
};
println(fatorial(5));
println(fatorial(10));
