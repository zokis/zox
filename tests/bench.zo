-# benchmark: recursive fib, sorting, dicts, closures, strings

-# recursive Fibonacci (500x fib(14))
$ fib(n) {
    ?(n <= 1) { n } : { fib(n-1) + fib(n-2) }
}

let fib_total = 0;
let i = 0;
@(i = 0; i < 500; i = i + 1) {
    fib_total = fib_total + fib(14)
}
println(fib_total)

-# bubble sort on 200-item list
$ make_list(n) {
    let acc = {};
    let k = 0;
    @(k = 0; k < n; k = k + 1) {
        acc = acc + {(n - k) * 3 % 97}
    }
    acc
}

$ bubble_sort(lst) {
    let n = len(lst);
    let i = 0;
    @(i = 0; i < n - 1; i = i + 1) {
        let j = 0;
        @(j = 0; j < n - i - 1; j = j + 1) {
            ?(lst[j] > lst[j+1]) {
                let tmp = lst[j];
                lst[j] = lst[j+1];
                lst[j+1] = tmp
            }
        }
    }
    lst
}

let unsorted = make_list(200);
let sorted   = bubble_sort(unsorted);
println(sorted[0])
println(sorted[199])

-# frequency count in dict (300 items)
~> string { toString };

$ freq_count(lst) {
    let counts = [];
    let i = 0;
    @(i = 0; i < len(lst); i = i + 1) {
        let k = toString(lst[i]);
        let found = find(keys(counts), k);
        ?(found >= 0) {
            counts{k} = counts{k} + 1
        } : {
            counts{k} = 1
        }
    }
    counts
}

let data = make_list(300);
let freq = freq_count(data);
println(len(freq))

-# map + filter + reduce with closures (400 items)
$ map(lst, f) {
    let result = {};
    let i = 0;
    @(i = 0; i < len(lst); i = i + 1) {
        result = result + {f(lst[i])}
    }
    result
}

$ filter(lst, pred) {
    let result = {};
    let i = 0;
    @(i = 0; i < len(lst); i = i + 1) {
        ?(pred(lst[i])) {
            result = result + {lst[i]}
        }
    }
    result
}

$ reduce(lst, f, init) {
    let acc = init;
    let i = 0;
    @(i = 0; i < len(lst); i = i + 1) {
        acc = f(acc, lst[i])
    }
    acc
}

$ make_adder(x) {
    $ adder(n) { n + x }
    adder
}

$ is_even_pred(x) { x % 2 == 0 }
$ add_two(a, b) { a + b }

let base    = make_list(400);
let shifted = map(base, make_adder(0));
let evens   = filter(shifted, is_even_pred);
let total   = reduce(evens, add_two, 0);
println(total)

-# string concatenation loop (1000 iterations)
$ build_string(n) {
    let s = "";
    let i = 0;
    @(i = 0; i < n; i = i + 1) {
        s = s + toString(i % 100)
    }
    len(s)
}

println(build_string(1000))

-# Cartesian product of two 30-item lists
$ cartesian(a, b) {
    let result = {};
    let i = 0;
    @(i = 0; i < len(a); i = i + 1) {
        let j = 0;
        @(j = 0; j < len(b); j = j + 1) {
            result = result + {{a[i], b[j]}}
        }
    }
    result
}

let xs    = make_list(30);
let ys    = make_list(30);
let pairs = cartesian(xs, ys);
println(len(pairs))

-# mutual recursion is_even/is_odd up to 200
$ is_even(n) { ?(n == 0) { true } : { is_odd(n - 1) } }
$ is_odd(n)  { ?(n == 0) { false } : { is_even(n - 1) } }

let even_count = 0;
let m = 0;
@(m = 0; m < 200; m = m + 1) {
    ?(is_even(m)) { even_count = even_count + 1 }
}
println(even_count)
