~> assert {assert_eq, assert_true, assert_false, assert_len, assert_summary};

-# mutual recursion
$ is_even(n) {
    ?(n == 0) { true } : { is_odd(n - 1) }
}

$ is_odd(n) {
    ?(n == 0) { false } : { is_even(n - 1) }
}

assert_true(is_even(0));
assert_false(is_odd(0));
assert_true(is_even(24));
assert_true(is_odd(25));
assert_false(is_even(31));

-# higher-order map/filter/reduce
$ map(lst, f) {
    let result = {};
    @(let i = 0; i < len(lst); i = i + 1) {
        result << f(lst[i])
    }
    result
}

$ filter(lst, pred) {
    let result = {};
    @(let i = 0; i < len(lst); i = i + 1) {
        ?(pred(lst[i])) {
            result << lst[i]
        }
    }
    result
}

$ reduce(lst, f, init) {
    let acc = init;
    @(let i = 0; i < len(lst); i = i + 1) {
        acc = f(acc, lst[i])
    }
    acc
}

$ square(x) { x * x }
$ is_even_value(x) { x % 2 == 0 }
$ add(a, b) { a + b }

let nums = {1, 2, 3, 4, 5, 6};
let squares = map(nums, square);
let evens = filter(nums, is_even_value);
let total = reduce(nums, add, 0);

assert_eq(squares, {1, 4, 9, 16, 25, 36});
assert_eq(evens, {2, 4, 6});
assert_eq(total, 21);
assert_len(map({}, square), 0);
assert_eq(reduce({}, add, 99), 99);

-# closures capture parent scope
$ make_threshold(limit) {
    $ above(n) {
        n > limit
    }
    above
}

let above_10 = make_threshold(10);
assert_false(above_10(10));
assert_true(above_10(11));

-# function factory
$ make_multiplier(factor) {
    $ multiply(n) {
        n * factor
    }
    multiply
}

let triple = make_multiplier(3);
let quadruple = make_multiplier(4);
assert_eq(triple(7), 21);
assert_eq(quadruple(7), 28);

-# simple currying
$ add3(a) {
    $ add_b(b) {
        $ add_c(c) {
            a + b + c
        }
        add_c
    }
    add_b
}

let add_to_2 = add3(2);
let add_to_5 = add_to_2(3);
assert_eq(add_to_5(4), 9);
assert_eq(add3(10)(20)(30), 60);

assert_summary();
