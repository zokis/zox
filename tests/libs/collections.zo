~> "./lib/collections.so" { range, zip, flatten, unique, chunk, count, group_by };
~> "./lib/assert.zo" { assert_eq, assert_len, assert_summary };

-# range
let r = range(0, 5, 1);
assert_len(r, 5)
assert_eq(r[0], 0)
assert_eq(r[4], 4)

let r2 = range(0, 10, 2);
assert_len(r2, 5)
assert_eq(r2[2], 4)

let r3 = range(5, 0, -1);
assert_len(r3, 5)
assert_eq(r3[0], 5)
assert_eq(r3[4], 1)

-# zip
let z = zip({1, 2, 3}, {10, 20, 30});
assert_len(z, 3)
assert_eq(z[0][0], 1)
assert_eq(z[0][1], 10)
assert_eq(z[2][1], 30)

-# zip com listas de tamanhos diferentes
let z2 = zip({1, 2}, {10, 20, 30});
assert_len(z2, 2)

-# flatten
let f = flatten({{1, 2}, {3, 4}, {5}});
assert_len(f, 5)
assert_eq(f[0], 1)
assert_eq(f[4], 5)

-# flatten com elemento nao-lista
let f2 = flatten({{1, 2}, 3, {4}});
assert_len(f2, 4)
assert_eq(f2[2], 3)

-# unique
let u = unique({1, 2, 1, 3, 2, 4});
assert_len(u, 4)
assert_eq(u[0], 1)
assert_eq(u[3], 4)

-# chunk
let c = chunk({1, 2, 3, 4, 5}, 2);
assert_len(c, 3)
assert_len(c[0], 2)
assert_len(c[2], 1)
assert_eq(c[0][0], 1)
assert_eq(c[1][0], 3)

-# count
assert_eq(count({1, 2, 1, 3, 1}, 1), 3)
assert_eq(count({1, 2, 3}, 4), 0)
assert_eq(count({"a", "b", "a"}, "a"), 2)

assert_summary()
