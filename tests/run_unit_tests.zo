~> os {exec};
~> string {split, replace, toString};

let zox_bin = "./zox";
let unit_dir = "tests/unit";

let raw = exec("ls " + unit_dir + "/*.zo");
let files = split(raw, "\n");

let pass = 0;
let fail = 0;
let failures = {};

println("");
println("==========================================");
println("  Zox Unit Test Suite");
println("==========================================");
println("");

@(let i = 0; i < len(files); i = i + 1) {
    let zo_file = files[i];
    ?(len(zo_file) == 0) { __> };

    let test_name = replace(replace(zo_file, unit_dir + "/", ""), ".zo", "");
    let output = exec(zox_bin + " " + zo_file + " 2>&1");
    let f1 = find(output, "Result: ");
    let f2 = find(output, " 0 failed");
    let cond = (f1 >= 0 && f2 >= 0);
    ?(cond) {
        println("  PASS  " + test_name);
        pass = pass + 1
    } : {
        println("  FAIL  " + test_name);
        println(output);
        fail = fail + 1;
        failures << test_name;
    }
};

println("");
println("------------------------------------------");
println("  Result: " + toString(pass) + " passed / " + toString(fail) + " failed");
println("------------------------------------------");

?(len(failures) > 0) {
    println("");
    println("Failed tests:");
    @(let j = 0; j < len(failures); j = j + 1) {
        println("  - " + failures[j])
    }
};

_>> ?(fail == 0) { 0 } : { 1 }
