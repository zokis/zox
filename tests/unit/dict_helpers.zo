~> test { test, suite,
           assert_eq, assert_true, assert_false,
           test_summary };

suite("Dict has_key");

$ dict_has_key() {
    let counts = ["a" -> 1; "b" -> 2];
    assert_true(has_key(counts, "a"));
    assert_false(has_key(counts, "z"))
}

$ dict_has_key_with_num() {
    let keyed = [];
    keyed{1} = "one";
    keyed{2} = "two";
    assert_true(has_key(keyed, 1));
    assert_false(has_key(keyed, 3))
}

suite("Dict get");

$ dict_get() {
    let counts = ["a" -> 1; "b" -> 2];
    assert_eq(get(counts, "a"), 1);
    assert_eq(get(counts, "z"), nil)
}

$ dict_get_with_num() {
    let keyed = [];
    keyed{1} = "one";
    keyed{2} = "two";
    assert_eq(get(keyed, 1), "one");
    assert_eq(get(keyed, 3), nil)
}

suite("Float key precision");

$ float_key_precision() {
    let approx = [];
    approx{1.0000001} = "low";
    approx{1.0000002} = "high";
    assert_eq(get(approx, 1.0000001), "low");
    assert_eq(get(approx, 1.0000002), "high")
}

test("dict has_key", dict_has_key);
test("dict has_key with num", dict_has_key_with_num);
test("dict get", dict_get);
test("dict get with num", dict_get_with_num);
test("float key precision", float_key_precision);

test_summary()
