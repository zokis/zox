-# Zox Speed Benchmark - Full Language Coverage

~> string { toString };
~> "./lib/collections.so" { range, flatten, unique, group_by };
~> "./lib/date.zo" { parse, format };

$ map(lst, f) {
    let result = {};
    @(let i = 0; i < len(lst); i = i + 1) { result << f(lst[i]) }
    result
}
$ filter(lst, pred) {
    let result = {};
    @(let i = 0; i < len(lst); i = i + 1) { ?(pred(lst[i])) { result << lst[i] } }
    result
}

-# 1. Recursion and Function Stress
$ fib(n) { ?(n <= 1) { n } : { fib(n-1) + fib(n-2) } }
let fib_total = 0;
@(let i = 0; i < 300; i = i + 1) { fib_total = fib_total + fib(14) }
println(fib_total)

-# 2. List and Sorting Stress
$ make_random_list(n) {
    let acc = {};
    @(let k = 0; k < n; k = k + 1) { acc << (n - k) * 123 % 97 }
    acc
}
$ bubble_sort(lst) {
    let n = len(lst);
    @(let i = 0; i < n - 1; i = i + 1) {
        @(let j = 0; j < n - i - 1; j = j + 1) {
            ?(lst[j] > lst[j+1]) {
                let tmp = lst[j]; lst[j] = lst[j+1]; lst[j+1] = tmp
            }
        }
    }
    lst
}
let sorted = bubble_sort(make_random_list(200));
println(sorted[0])
println(sorted[199])

-# 3. Operators - Bitwise & Logical
let bit_val = 0;
@(let b = 0; b < 1000; b = b + 1) {
    bit_val = (bit_val | b) & 255;
    bit_val = (bit_val ^ 170) << 1 >> 1;
    ?(b % 2 == 0 && b % 3 == 0 || b % 5 == 0) { bit_val = bit_val + 1 }
}
println(bit_val)

-# 4. List Operations - Sets & Mapped Operators
let l1 = {1, 2, 3, 4, 5, 6, 7, 8};
let l2 = {5, 6, 7, 8, 9, 10, 11, 12};
let l_union = l1 | l2;
let l_inter = l1 & l2;
let l_diff  = l1 - l2;
let l_sym   = l1 ^ l2;
println(len(l_union) + len(l_inter) + len(l_diff) + len(l_sym))

-# Mapped operators (e.g., list &+ number)
let l_mapped = (l1 &+ 10) &* 2;
println(l_mapped[0])

-# 5. Dict Stress
let d_merged = ["a" -> 1; "b" -> 2] + ["b" -> 3; "c" -> 4];
println(d_merged{"b"})
println(len(d_merged))

-# 6. Custom Types & Pattern Matching
type Node { val, left, right };
$ build_tree(d) {
    ?(d == 0) { _>> nil }
    _>> Node(d, build_tree(d-1), build_tree(d-1))
}
$ sum_tree(n) {
    ?? (n) {
        n == nil => 0,
        _        => n.val + sum_tree(n.left) + sum_tree(n.right)
    }
}
let tree = build_tree(7);
println(sum_tree(tree))

-# 7. String Operations
$ string_stress(n) {
    let s = "base";
    @(let i = 0; i < n; i = i + 1) {
        s = (s + toString(i % 10)) - "1" - "2";
        ?(len(s) > 20) { s = s * 0 } -# clear string if too long
    }
    len(s)
}
println(string_stress(500))

-# 8. Results & While Loops
$ risky_op(x) {
    ?(x % 13 == 0) { _>>! "bad" } : { _>>@ x / 2 }
}
let ok_sum = 0;
let k = 0;
#(k < 500) {
    let res = risky_op(k);
    ?? (res) {
        is_ok(res) => { ok_sum = ok_sum + get_ok(res) },
        _          => { nil }
    }
    k = k + 1
}
println(ok_sum)

-# 9. Collections & Date Lib
let r = range(0, 50, 1);
$ is_odd(x) { x % 2 != 0 }
$ dbl_pair(x) { {x, x} }
let g = group_by(unique(flatten(map(r, dbl_pair))), is_odd);
println(len(g{"true"}))

let dt = parse("2026-05-03 15:00:00");
println(format(dt, "YYYY"))

-# 10. Arena Stress
let arena_result = |{
    let huge_list = {};
    @(let h = 0; h < 1000; h = h + 1) { huge_list << h }
    _>> len(huge_list)
}|;
println(arena_result)
