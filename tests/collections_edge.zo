~> assert {assert_eq, assert_true, assert_false, assert_len, assert_in,
           assert_not_in, assert_summary};

-# nested lists
let matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
assert_eq(matrix[0][1], 2);
assert_eq(matrix[1][2], 6);
assert_eq(matrix[2][0], 7);
assert_len(matrix, 3);
assert_len(matrix[0], 3);

-# mutate nested list element by reference
let row = matrix[1];
row[1] = 99;
assert_eq(matrix[1][1], 99);

-# lists of dicts
let pessoas = {
    ["nome" -> "Alice"; "idade" -> 30],
    ["nome" -> "Bob";   "idade" -> 25],
    ["nome" -> "Carol"; "idade" -> 35]
};
assert_eq(pessoas[0]{"nome"}, "Alice");
assert_eq(pessoas[1]{"idade"}, 25);
assert_eq(pessoas[2]{"nome"}, "Carol");
assert_len(pessoas, 3);

-# dicts with list values
let d = ["pares" -> {2, 4, 6}; "impares" -> {1, 3, 5}];
assert_eq(d{"pares"}[0], 2);
assert_eq(d{"impares"}[2], 5);
assert_len(d{"pares"}, 3);

-# mutate list inside dict by reference
let pares = d{"pares"};
pares[0] = 100;
assert_eq(d{"pares"}[0], 100);

-# empty list and append
let vazia = {};
assert_len(vazia, 0);
vazia << 42;
assert_len(vazia, 1);
assert_eq(vazia[0], 42);

-# slices
let a = {10, 20, 30, 40, 50};
assert_eq(a[1:3], {20, 30});
assert_eq(a[:2],  {10, 20});
assert_eq(a[3:],  {40, 50});

-# negative index
assert_eq(a[-1], 50);
assert_eq(a[-2], 40);

-# start >= end slice returns empty list
let s = a[3:1];
assert_len(s, 0);

-# string list
let palavras = {"zox", "e", "legal"};
assert_eq(palavras[0], "zox");
assert_in("legal", palavras);
assert_not_in("python", palavras);

-# set operations
let x = {1, 2, 2, 3};
let y = {2, 3, 3, 4};
assert_eq(x & y, {2, 3});
assert_eq(x - y, {1});  -# set difference: elementos de x que nao estao em y (sem duplicatas)

-# Cartesian product
let ab = {"a", "b"};
let nums = {1, 2};
let prod = ab * nums;
assert_len(prod, 4);
assert_eq(prod[0], {"a", 1});
assert_eq(prod[3], {"b", 2});

-# empty dict insertion
let ed = [];
ed{"chave"} = "valor";
assert_eq(ed{"chave"}, "valor");
assert_len(ed, 1);

-# dict merge, right side overwrites
let d1 = ["a" -> 1; "b" -> 2];
let d2 = ["b" -> 99; "c" -> 3];
let merged = d1 + d2;
assert_eq(merged{"a"}, 1);
assert_eq(merged{"b"}, 99);
assert_eq(merged{"c"}, 3);

-# deeply nested list
let deep = {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}};
assert_eq(deep[0][0][0], 1);
assert_eq(deep[1][1][1], 8);

-# element-wise
let nums2 = {1, 2, 3, 4};
assert_eq(nums2 &+ 10, {11, 12, 13, 14});
assert_eq(nums2 &* 2,  {2, 4, 6, 8});
assert_eq(nums2 &- 1,  {0, 1, 2, 3});

assert_summary();
