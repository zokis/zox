~> test { test, suite,
           assert_eq, assert_len, assert_in, assert_not_in,
           test_summary };

suite("List basics");

$ list_literal() {
    let xs = {1, 2, 3};
    assert_len(xs, 3);
    assert_eq(xs[0], 1);
    assert_eq(xs[2], 3)
}

$ list_concat() {
    let a = {1, 2, 3};
    let b = {4, 5, 6};
    let c = {7, 8, 9};
    assert_eq(a + b + c, {1, 2, 3, 4, 5, 6, 7, 8, 9})
}

$ list_append() {
    let xs = {1, 2};
    xs << 3;
    xs << 4;
    assert_len(xs, 4);
    assert_eq(xs[2], 3);
    assert_eq(xs[3], 4)
}

$ list_mutation() {
    let xs = {10, 20, 30};
    xs[1] = 99;
    assert_eq(xs[1], 99);
    assert_eq(xs, {10, 99, 30})
}

suite("Slicing");

$ slice_range() {
    let a = {10, 20, 30, 40, 50};
    assert_eq(a[1:3], {20, 30});
    assert_eq(a[:2],  {10, 20});
    assert_eq(a[3:],  {40, 50})
}

$ slice_negative_index() {
    let a = {10, 20, 30, 40, 50};
    assert_eq(a[-1], 50);
    assert_eq(a[-2], 40)
}

$ slice_empty() {
    let a = {10, 20, 30, 40, 50};
    assert_len(a[3:1], 0)
}

$ slice_oob_clamps() {
    let xs = {10, 20, 30, 40};
    assert_eq(xs[-99:2],   {10, 20});
    assert_eq(xs[2:99],    {30, 40});
    assert_eq(xs[-99:99],  {10, 20, 30, 40});
    assert_len(xs[99:100], 0)
}

suite("Set operations");

$ set_diff() {
    let x = {1, 2, 3, 4};
    let y = {3, 4, 5};
    assert_eq(x - y, {1, 2})
}

$ set_intersection() {
    let x = {1, 2, 3};
    let y = {2, 3, 4};
    assert_eq(x & y, {2, 3})
}

$ set_union() {
    let x = {1, 2, 3};
    let y = {3, 4, 5};
    let u = x | y;
    assert_in(1, u);
    assert_in(3, u);
    assert_in(5, u)
}

$ set_cartesian() {
    let ab = {"a", "b"};
    let ns = {1, 2};
    let prod = ab * ns;
    assert_len(prod, 4);
    assert_eq(prod[0], {"a", 1});
    assert_eq(prod[3], {"b", 2})
}

$ list_repeat() {
    let xs = {1, 2} * 3;
    assert_eq(xs, {1, 2, 1, 2, 1, 2})
}

suite("Element-wise operators");

$ elementwise() {
    let ns = {1, 2, 3, 4};
    assert_eq(ns &+ 10, {11, 12, 13, 14});
    assert_eq(ns &* 2,  {2,  4,  6,  8});
    assert_eq(ns &- 1,  {0,  1,  2,  3});
    assert_eq(ns &/ 2,  {0.5, 1, 1.5, 2})
}

$ elementwise_modulo() {
    let ns = {8, 12, 16};
    assert_eq(ns &% 5, {3, 2, 1})
}

suite("Nested lists");

$ nested_index() {
    let matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    assert_eq(matrix[0][1], 2);
    assert_eq(matrix[1][2], 6);
    assert_eq(matrix[2][0], 7)
}

$ nested_mutation() {
    let matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
    let row = matrix[1];
    row[1] = 99;
    assert_eq(matrix[1][1], 99)
}

$ deeply_nested() {
    let deep = {{{1, 2}, {3, 4}}, {{5, 6}, {7, 8}}};
    assert_eq(deep[0][0][0], 1);
    assert_eq(deep[1][1][1], 8)
}

$ membership() {
    let xs = {"zox", "is", "fun"};
    assert_in("zox", xs);
    assert_not_in("python", xs)
}

test("literal and index",   list_literal);
test("concat",              list_concat);
test("append",              list_append);
test("mutation",            list_mutation);
test("slice range",         slice_range);
test("negative index",      slice_negative_index);
test("empty slice",         slice_empty);
test("oob clamps",          slice_oob_clamps);
test("set difference",      set_diff);
test("set intersection",    set_intersection);
test("set union",           set_union);
test("cartesian product",   set_cartesian);
test("list repeat",         list_repeat);
test("element-wise",        elementwise);
test("element-wise modulo", elementwise_modulo);
test("nested indexing",     nested_index);
test("nested mutation",     nested_mutation);
test("deeply nested",       deeply_nested);
test("membership",          membership);

test_summary()
