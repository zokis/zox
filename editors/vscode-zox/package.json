{
  "name": "zox-language",
  "displayName": "Zox",
  "description": "Syntax highlighting for the Zox programming language",
  "version": "1.0.0",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "zox",
      "aliases": ["Zox", "zox"],
      "extensions": [".zo"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "zox",
      "scopeName": "source.zox",
      "path": "./syntaxes/zox.tmLanguage.json"
    }]
  }
}
