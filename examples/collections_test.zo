~> string { toString };

let xs = {10, 20, 30};
println("xs0=" + toString(xs[0]));
println("xs2=" + toString(xs[2]));

xs[1] = 99;
println("xs1=" + toString(xs[1]));
xs << 123;
println("xs3=" + toString(xs[3]));

let user = ["name" -> "Ana"; "age" -> 28];
println("name=" + user{"name"});
println("age=" + toString(user{"age"}));

user{"age"} = 29;
println("age2=" + toString(user{"age"}));

let nested = ["nums" -> {1, 2, 3}];
println("nested0=" + toString(nested{"nums"}[0]));

nested{"nums"}[2] = 42;
println("nested2=" + toString(nested{"nums"}[2]));

let ys = {10, 20, 30, 40, 50};
let sliceA = ys[1:3];
let sliceB = ys[:2];
let sliceC = ys[3:];
println("slice_a0=" + toString(sliceA[0]));
println("slice_a1=" + toString(sliceA[1]));
println("slice_b_len=" + toString(len(sliceB)));
println("slice_c0=" + toString(sliceC[0]));
println("slice_c1=" + toString(sliceC[1]));
