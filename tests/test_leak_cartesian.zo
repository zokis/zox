$ cartesian(a, b) {
    let result = {};
    let i = 0;
    @(i = 0; i < len(a); i = i + 1) {
        let j = 0;
        @(j = 0; j < len(b); j = j + 1) {
            result = result + {{a[i], b[j]}}
        }
    }
    result
}
let xs = {1, 2, 3};
let ys = {4, 5, 6};
let pairs = cartesian(xs, ys);
println(len(pairs));

