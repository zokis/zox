~> os {exec, env, args};

let zox_path = args()[0];
println(typeof(zox_path));

let out = exec("echo hello_zox");
println(out);

let home = env("HOME");
println(typeof(home));

let missing = env("ZOX_VAR_THAT_DOES_NOT_EXIST");
println(missing);

let files = exec("echo file1 file2 file3");
println(files);
