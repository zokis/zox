~> os     {exec};
~> string {split, replace, toString};

let zox_bin = "./zox";

let raw   = exec("ls tests/*.expected");
let files = split(raw, "\n");

let pass     = 0;
let fail     = 0;
let failures = {};

println("");
println("==========================================");
println("  Zox Test Suite");
println("==========================================");
println("");

@ (let i = 0; i < len(files); i = i + 1) {
  let expected_file = files[i];
  ? (len(expected_file) == 0) { __> };

  let test_name = replace(replace(expected_file, "tests/", ""), ".expected", "");
  let zo_file   = "tests/" + test_name + ".zo";

  let exists = exec("test -f " + zo_file + " && echo yes || echo no");
  ? (exists != "yes") {
    println("  SKIP  " + test_name);
    __>
  };

  let actual   = exec(zox_bin + " " + zo_file);
  let expected = exec("cat " + expected_file);

  ? (actual == expected) {
    println("  PASS  " + test_name);
    pass = pass + 1;
  } : {
    println("  FAIL  " + test_name);
    fail = fail + 1;
    failures = failures + {test_name};
  }
};

println("");
println("------------------------------------------");
println("  Resultado: " + toString(pass) + " passou(ram) / " + toString(fail) + " falhou(ram)");
println("------------------------------------------");

? (len(failures) > 0) {
  println("");
  @ (let i = 0; i < len(failures); i = i + 1) {
    let name     = failures[i];
    let exp_out  = exec("cat tests/" + name + ".expected");
    let got_out  = exec(zox_bin + " tests/" + name + ".zo");
    println("  x " + name);
    println("    esperado:");
    let exp_lines = split(exp_out, "\n");
    @ (let j = 0; j < len(exp_lines); j = j + 1) {
      println("      " + exp_lines[j]);
    };
    println("    obtido:");
    let got_lines = split(got_out, "\n");
    @ (let j = 0; j < len(got_lines); j = j + 1) {
      println("      " + got_lines[j]);
    };
    println("")
  }
};
